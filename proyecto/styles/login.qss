QWidget {
    background: #FFFFFF;
}

#tarjeta {
    background: #F5F5F5;
    border-radius: 20px;
    border: 2px solid #DD27F5;
    padding: 10px;
}

#subtitulo {
    color: violet;
    font-size: 40px;
}

#logo {
    font-size: 60px;
}

QLineEdit {
    background: #DD27F5;
    border: 2px solid black;
    border-radius: 12px;
    font-size: 20px;
    color: black;
    padding: 8px;
}

QLineEdit:focus {
    background: #E1BEE7;
    border: 2px solid black;
}

QPushButton {
    background: #DD27F5;
    border: 2px solid black;
    border-radius: 12px;
    font-size: 20px;
    color: black;
    padding: 8px;
}

#boton {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #7485F6,
        stop:1 #8DD7BF
    );
    border: 8px solid #54D199;
    font-size: 30px;
    color: white;
    font-weight: bold;
}

#boton:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #7154D1,
        stop:1 #D1546B
    );
}

#boton:pressed {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #BD283B,
        stop:1 #EA9EA8
    );
}

QCheckBox {
    font-size: 16px;
}

QComboBox, QSpinBox, QDateEdit, QTextEdit {
    background: white;
    border: 2px solid #DD27F5;
    border-radius: 8px;
    padding: 6px;
    font-size: 16px;
}
