QWidget{
  background: #FFFFFF;
}

#subtitulo{
  color:violet;
  font-size:40px;
}

#logo{
  font-size:60px;
}

QLineEdit{
  background: #DD27F5;
  border:2px solid black;
  border-radius:12px;
  font-size: 20px;
  color:black;
}

QLineEdit:focus{
  background:#E1BEE7;
  border:2px solid black;
}

QPushButton{
  background: #DD27F5;
  border:2px solid black;
  border-radius:12px;
  font-size: 20px;
  color:black;
}

#boton{
  background:qlineargradient(
    x1:0,y1:0,x2:1,y2:1,
    stop:0 #7485F6,
    stop:1 #8DD7BF
  );
  border:8px solid #54D199;
  font-size: 30px;
  color: white;
  font-weight:bold;
}

#boton:hover{
  background:qlineargradient(
    x1:0,y1:0,x2:1,y2:1,
    stop:0 #7154D1,
    stop:1 #D1546B
  );
}

#boton:pressed{
  background:qlineargradient(
    x1:0,y1:0,x2:1,y2:1,
    stop:0 #BD283B,
    stop:1 #EA9EA8
  );
}

